<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project="build/mod.build.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        <AssemblyName Condition="'$(Configuration)' == 'Debug'">ShoreMagicianEditorStub</AssemblyName>
        <AssemblyName Condition="'$(Configuration)' != 'Debug'">ShoreMagician</AssemblyName>
        <ModOutputFolder>ShoreMagician</ModOutputFolder>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="ShoreMagician/localization/**/*.json"/>
        <None Include="ShoreMagician/**"/>
        <None Include="ShoreMagicianCode/**"/>
        <None Include="ShoreMagician.json"/>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <Compile Include="ShoreMagicianCode/**/*.cs"/>
    </ItemGroup>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent"
            Condition="'$(Configuration)' != 'Debug'">
        <MakeDir Directories="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="ShoreMagician.json" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModsPath)$(ModOutputFolder)/"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
    </Target>
</Project>
